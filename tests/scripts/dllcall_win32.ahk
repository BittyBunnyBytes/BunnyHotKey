out(s) => FileAppend(s "`n", "*")
DetectHiddenWindows true

; ---- memory and strings
src := Buffer(8), dst := Buffer(8, 0)
NumPut("Int64", 0x1122334455667788, src)
DllCall("RtlMoveMemory", "Ptr", dst, "Ptr", src, "UPtr", 8)
out("move " Format("{:X}", NumGet(dst, "Int64")))
DllCall("RtlFillMemory", "Ptr", dst, "UPtr", 3, "UChar", 0xAB)
out("fill " Format("{:X}", NumGet(dst, "Int64")))
DllCall("RtlZeroMemory", "Ptr", dst, "UPtr", 8)
out("zero " NumGet(dst, "Int64"))
out("memcpy " (DllCall("msvcrt\memcpy", "Ptr", dst, "Ptr", src, "UPtr", 4, "Ptr") = dst.Ptr) " " Format("{:X}", NumGet(dst, "UInt")))
out("lstrlen " DllCall("lstrlenW", "Str", "bunny") " " DllCall("lstrlen", "Ptr", StrPtr("hot key")) " " DllCall("lstrlenA", "AStr", "abc"))
out("muldiv " DllCall("MulDiv", "Int", 10, "Int", 3, "Int", 4) " " DllCall("MulDiv", "Int", -5, "Int", 1, "Int", 2) " " DllCall("MulDiv", "Int", 1, "Int", 1, "Int", 0) " " DllCall("MulDiv", "Int", 0x7FFFFFFF, "Int", 4, "Int", 1))

; ---- system information
size := 1
r := DllCall("GetComputerName", "Ptr", 0, "UInt*", &size)
out("computer small " r " " A_LastError " " (size = StrLen(A_ComputerName) + 1))
buf := Buffer(size * 2)
r := DllCall("GetComputerName", "Ptr", buf, "UInt*", &size)
out("computer " r " " (StrGet(buf) = A_ComputerName) " " (size = StrLen(A_ComputerName)))
size := 64, buf := Buffer(128)
r := DllCall("GetUserName", "Ptr", buf, "UInt*", &size)
out("user " r " " (StrGet(buf) = A_UserName) " " (size = StrLen(A_UserName) + 1))
n := DllCall("GetTempPath", "UInt", 0, "Ptr", 0)
buf := Buffer(n * 2)
out("temp " (DllCall("GetTempPath", "UInt", n, "Ptr", buf) = n - 1) " " (SubStr(StrGet(buf), -1) = "/"))
out("cmdline " (InStr(StrGet(DllCall("GetCommandLine", "Ptr")), "dllcall_win32.ahk") > 0))
DllCall("SetEnvironmentVariable", "Str", "BHK_TEST", "Str", "carrot")
out("getenv " EnvGet("BHK_TEST") " " DllCall("GetEnvironmentVariable", "Str", "BHK_TEST", "Ptr", 0, "UInt", 0))
buf := Buffer(64)
out("getenv " DllCall("GetEnvironmentVariable", "Str", "BHK_TEST", "Ptr", buf, "UInt", 32) " " StrGet(buf))
buf := Buffer(128)
out("expand " DllCall("ExpandEnvironmentStrings", "Str", "a%BHK_TEST%b%NOPE_XYZ%", "Ptr", buf, "UInt", 64) " " StrGet(buf))
DllCall("SetEnvironmentVariable", "Str", "BHK_TEST", "Ptr", 0)
out("unset " DllCall("GetEnvironmentVariable", "Str", "BHK_TEST", "Ptr", buf, "UInt", 32) " " A_LastError " [" EnvGet("BHK_TEST") "]")
st := Buffer(16, 0)
DllCall("GetLocalTime", "Ptr", st)
out("localtime " (NumGet(st, 0, "UShort") = A_Year) " " (NumGet(st, 2, "UShort") = A_Mon) " " (NumGet(st, 4, "UShort") = A_WDay - 1) " " (NumGet(st, 6, "UShort") = A_DD))
DllCall("GetSystemTime", "Ptr", st)
out("systime " (NumGet(st, 0, "UShort") = SubStr(A_NowUTC, 1, 4)))
ft := Buffer(8)
NumPut("Int64", 133000000000000000 + 1234567, ft)     ; 2022-06-18 04:26:40.123 UTC, a Saturday
out("ft2st " DllCall("FileTimeToSystemTime", "Ptr", ft, "Ptr", st))
s := ""
loop 8
    s .= NumGet(st, (A_Index - 1) * 2, "UShort") " "
out("ft2st " s)
out("closehandle " DllCall("CloseHandle", "Ptr", 123))

; ---- libraries
hk := DllCall("GetModuleHandle", "Str", "kernel32", "Ptr")
pa := DllCall("GetProcAddress", "Ptr", hk, "AStr", "MulDiv", "Ptr")
out("pseudo " (hk != 0) " " (pa != 0) " " DllCall(pa, "Int", 6, "Int", 7, "Int", 2))
out("pseudo missing " DllCall("GetProcAddress", "Ptr", hk, "AStr", "NoSuchThing", "Ptr") " " A_LastError)
out("loaddll " DllCall("LoadLibrary", "Str", "nonexistent_thing.dll", "Ptr") " " A_LastError)
hm := DllCall("LoadLibrary", "Str", "libm.so.6", "Ptr")
cosp := DllCall("GetProcAddress", "Ptr", hm, "AStr", "cos", "Ptr")
out("libm " (hm != 0) " " (cosp != 0) " " DllCall(cosp, "Double", 0.0, "Double"))
out("libm missing " DllCall("GetProcAddress", "Ptr", hm, "AStr", "no_such_fn", "Ptr") " " A_LastError)
out("free " DllCall("FreeLibrary", "Ptr", hm) " " DllCall("FreeLibrary", "Ptr", 999) " " A_LastError)
out("modself " (DllCall("GetModuleHandle", "Ptr", 0, "Ptr") != 0))

; ---- windows (a Gui of this script)
g := Gui(, "BHK DllCall target")
e := g.AddEdit("w150", "hello")
b := g.AddButton(, "Push")
g.Show("x100 y100 w300 h120 NA")
out("find " (DllCall("FindWindow", "Ptr", 0, "Str", "BHK DllCall target", "Ptr") = g.Hwnd) " " DllCall("FindWindow", "Ptr", 0, "Str", "no such window zz", "Ptr"))
out("findex " (DllCall("FindWindowEx", "Ptr", g.Hwnd, "Ptr", 0, "Str", "Button", "Ptr", 0, "Ptr") = b.Hwnd) " " (DllCall("FindWindowEx", "Ptr", g.Hwnd, "Ptr", 0, "Str", "Edit", "Str", "hello", "Ptr") = e.Hwnd))
cls := Buffer(256)
n := DllCall("GetClassName", "Ptr", e.Hwnd, "Ptr", cls, "Int", 128)
out("class " n " " StrGet(cls) " " (DllCall("GetClassName", "Ptr", g.Hwnd, "Ptr", cls, "Int", 128) = StrLen(WinGetClass("ahk_id " g.Hwnd))))
pid := 0
out("pid " (DllCall("GetWindowThreadProcessId", "Ptr", g.Hwnd, "UInt*", &pid) != 0) " " (pid = ProcessExist()))
out("parent " (DllCall("GetParent", "Ptr", e.Hwnd, "Ptr") = g.Hwnd) " " (DllCall("GetAncestor", "Ptr", b.Hwnd, "UInt", 2, "Ptr") = g.Hwnd) " " DllCall("GetParent", "Ptr", g.Hwnd, "Ptr"))
out("style " ((DllCall("GetWindowLong", "Ptr", e.Hwnd, "Int", -16) & 0x40000000) != 0) " " (DllCall("GetWindowLongPtr", "Ptr", g.Hwnd, "Int", -16, "Ptr") & 0xFFFFFFFF = WinGetStyle("ahk_id " g.Hwnd)))
out("iswin " DllCall("IsWindow", "Ptr", g.Hwnd) " " DllCall("IsIconic", "Ptr", g.Hwnd) " " DllCall("IsZoomed", "Ptr", g.Hwnd))
rc := Buffer(16)
DllCall("GetClientRect", "Ptr", e.Hwnd, "Ptr", rc)
out("clientrect " NumGet(rc, 0, "Int") " " NumGet(rc, 4, "Int") " " (NumGet(rc, 8, "Int") > 0))
out("windowrect " DllCall("GetWindowRect", "Ptr", g.Hwnd, "Ptr", rc) " " (NumGet(rc, 8, "Int") > NumGet(rc, 0, "Int")))
out("badwin " DllCall("GetWindowRect", "Ptr", 0x7777777, "Ptr", rc) " " A_LastError)
out("showctl " DllCall("ShowWindow", "Ptr", b.Hwnd, "Int", 0) " " b.Visible " " DllCall("ShowWindow", "Ptr", b.Hwnd, "Int", 5) " " b.Visible)
g.Destroy()
out("done")
