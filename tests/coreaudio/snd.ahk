out := (x) => FileAppend(x "`n", "*")
IID_IAudioEndpointVolume := "{5CDF2C82-841E-4546-9722-0CF74078229A}"
ep := SoundGetInterface(IID_IAudioEndpointVolume)
out("ptr " (ep > 0))
ComCall(9, ep, "Float*", &v := 0)
out("scalar " Round(v, 2) " vs " Round(SoundGetVolume() / 100, 2))
ComCall(5, ep, "UInt*", &n := 0)
out("channels " n)
ComCall(15, ep, "Int*", &m := 0)
out("mute " m " vs " SoundGetMute())
ComCall(20, ep, "Float*", &lo := 0, "Float*", &hi := 0, "Float*", &st := 0)
out("range " lo " " hi " " st)
ComCall(8, ep, "Float*", &db := 0)
out("db " Round(db, 1))
old := v
ComCall(7, ep, "Float", 0.30, "Ptr", 0)
out("set30 -> " Round(SoundGetVolume()))
ComCall(7, ep, "Float", old, "Ptr", 0)
out("restored " Round(SoundGetVolume() / 100, 2))
try ComCall(7, ep, "Float", 2.0, "Ptr", 0)
catch OSError as e
    out("bad " e.Message)
out("release " ObjRelease(ep))
meter := SoundGetInterface("{C02216F6-8C67-4B5B-9D00-D008E73E0064}")
Sleep 200
ComCall(3, meter, "Float*", &peak := -1)
out("peak ok " (peak >= 0 && peak <= 1))
ObjRelease(meter)
out("unknown " SoundGetInterface("{11111111-2222-3333-4444-555555555555}"))
mute := SoundGetInterface("{DF45AEEA-B74A-4B6B-AFAD-2366B6AA012E}", "Master")
ComCall(4, mute, "Int*", &mm := 9)
out("comp mute " mm)
ObjRelease(mute)
try SoundGetInterface("IAudioEndpointVolume")
catch ValueError as e
    out("verr " e.Message)
